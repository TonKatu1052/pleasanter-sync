{
  "name": "pleasanter-sync",
  "displayName": "pleasanter-sync",
  "description": "",
  "version": "0.0.3",
  "publisher": "tonkatu1052",
  "license": "MIT",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pleasanterSync.selectSite",
        "title": "PleasanterSync: Select Site"
      },
      {
        "command": "pleasanterSync.getSiteCode",
        "title": "PleasanterSync: Get Site Code"
      }
    ],
    "keybindings": [
      {
        "command": "pleasanterSync.selectSite",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "pleasanterSync.getSiteCode",
        "key": "ctrl+shift+alt+p",
        "when": "editorFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.118.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "yaml": "^2.8.4"
  }
}
